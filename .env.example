RACK_ENV=development
PORT=4567
# Used by docker-compose.yml via ${VAR:-default} interpolation.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=paywithruby_dev
POSTGRES_PORT=5432
# Must match the POSTGRES_* values above when running locally.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/paywithruby_dev
# Isolated test database. Same server, different name. Never point this to dev.
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/paywithruby_test
JWT_SECRET=change-me-locally
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_SANDBOX=true
